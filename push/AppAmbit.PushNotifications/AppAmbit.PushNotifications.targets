<Project>
  <!-- Copy iOS native dynamic frameworks to app bundle -->

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <_AppAmbitPushSdkPath>$(MSBuildThisFileDirectory)</_AppAmbitPushSdkPath>
    <_IsSimulator Condition="'$(RuntimeIdentifier)' == '' OR $(RuntimeIdentifier.Contains('simulator'))">true</_IsSimulator>
    <_IsSimulator Condition="'$(_IsSimulator)' == ''">false</_IsSimulator>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios' AND '$(_IsSimulator)' == 'true'">
    <_AppAmbitFrameworkPath>$(_AppAmbitPushSdkPath)Platforms/iOS_Build/build/Debug-iphonesimulator</_AppAmbitFrameworkPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios' AND '$(_IsSimulator)' == 'false'">
    <_AppAmbitFrameworkPath>$(_AppAmbitPushSdkPath)Platforms/iOS_Build/build/Debug-iphoneos</_AppAmbitFrameworkPath>
  </PropertyGroup>

  <!-- Compute AppBundleDir if not defined -->
  <Target Name="_ComputeAppAmbitBundleDir"
          BeforeTargets="CopyAppAmbitPushFrameworks"
          Condition="'$(TargetFramework)' == 'net10.0-ios' AND '$(OutputType)' == 'Exe'">
    <PropertyGroup Condition="'$(AppBundleDir)' == ''">
      <_AppName>$(AssemblyName)</_AppName>
      <_ComputedAppBundleDir>$(TargetDir.TrimEnd('\').TrimEnd('/'))/$(_AppName).app</_ComputedAppBundleDir>
      <AppBundleDir Condition="Exists('$(_ComputedAppBundleDir)')">$(_ComputedAppBundleDir)</AppBundleDir>
    </PropertyGroup>
  </Target>

  <!--
    Copy frameworks BEFORE _CodesignAppBundle so the toolchain includes them in
    CodeResources and signs them with the resolved developer identity.
    Runs after _CreateAppBundle to ensure the bundle directory exists.
  -->
  <Target Name="CopyAppAmbitPushFrameworks"
          AfterTargets="_CreateAppBundle"
          BeforeTargets="_CodesignAppBundle"
          Condition="'$(TargetFramework)' == 'net10.0-ios' AND '$(OutputType)' == 'Exe' AND '$(AppBundleDir)' != ''">
    <PropertyGroup>
      <_FrameworksDir>$(AppBundleDir)/Frameworks</_FrameworksDir>
    </PropertyGroup>

    <MakeDir Directories="$(_FrameworksDir)" ContinueOnError="true" />

    <!-- Copy AppAmbitPushNotifications.framework -->
    <Exec Condition="'$(_AppAmbitFrameworkPath)' != '' AND Exists('$(_AppAmbitFrameworkPath)/AppAmbitPushNotifications.framework')"
          Command="cp -R &quot;$(_AppAmbitFrameworkPath)/AppAmbitPushNotifications.framework&quot; &quot;$(_FrameworksDir)/&quot;"
          ContinueOnError="true" />
    <!-- Fallback: subdirectory layout -->
    <Exec Condition="'$(_AppAmbitFrameworkPath)' != '' AND !Exists('$(_AppAmbitFrameworkPath)/AppAmbitPushNotifications.framework') AND Exists('$(_AppAmbitFrameworkPath)/AppAmbitPushNotifications/AppAmbitPushNotifications.framework')"
          Command="cp -R &quot;$(_AppAmbitFrameworkPath)/AppAmbitPushNotifications/AppAmbitPushNotifications.framework&quot; &quot;$(_FrameworksDir)/&quot;"
          ContinueOnError="true" />

    <!-- Copy AppAmbit.framework -->
    <Exec Condition="'$(_AppAmbitFrameworkPath)' != '' AND Exists('$(_AppAmbitFrameworkPath)/AppAmbit.framework')"
          Command="cp -R &quot;$(_AppAmbitFrameworkPath)/AppAmbit.framework&quot; &quot;$(_FrameworksDir)/&quot;"
          ContinueOnError="true" />
    <!-- Fallback: subdirectory layout -->
    <Exec Condition="'$(_AppAmbitFrameworkPath)' != '' AND !Exists('$(_AppAmbitFrameworkPath)/AppAmbit.framework') AND Exists('$(_AppAmbitFrameworkPath)/AppAmbitSdk/AppAmbit.framework')"
          Command="cp -R &quot;$(_AppAmbitFrameworkPath)/AppAmbitSdk/AppAmbit.framework&quot; &quot;$(_FrameworksDir)/&quot;"
          ContinueOnError="true" />

    <!-- Remove stale _CodeSignature so the toolchain can sign fresh -->
    <Exec Condition="Exists('$(_FrameworksDir)/AppAmbitPushNotifications.framework/_CodeSignature')"
          Command="rm -rf &quot;$(_FrameworksDir)/AppAmbitPushNotifications.framework/_CodeSignature&quot;" />
    <Exec Condition="Exists('$(_FrameworksDir)/AppAmbit.framework/_CodeSignature')"
          Command="rm -rf &quot;$(_FrameworksDir)/AppAmbit.framework/_CodeSignature&quot;" />

    <Message Importance="High" Text="[AppAmbit.PushNotifications] Frameworks copied to $(_FrameworksDir)" />
  </Target>
</Project>
