push/AppAmbit.PushNotifications/Platforms/iOS_Build/Podfile.lock
push/AppAmbit.PushNotifications/Platforms/iOS_Build/DerivedData/
push/AppAmbit.PushNotifications/Platforms/iOS_Build/.build/

# Keep Podfile
!push/AppAmbit.PushNotifications/Platforms/iOS_Build/Podfile

