<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AppAmbitTestingApp"
             xmlns:models="clr-namespace:AppAmbitTestingApp.Models"
             xmlns:utils="clr-namespace:AppAmbitTestingApp.Utils"
             x:Class="AppAmbitTestingApp.CmsPage"
             Title="CMS Showcase">

    <ContentPage.Resources>
        <utils:ListToStringConverter x:Key="ListToStringConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Controls -->
        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="10">

            <Label Text="CMS Query Builder"
                   FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Filter Picker + Apply button -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="FilterPicker"
                        Title="Select a filter..."
                        HorizontalOptions="FillAndExpand" />
                <Button Text="Apply"
                        Clicked="OnApplyFilterClicked"
                        HorizontalOptions="End" />
            </Grid>

            <!-- Search -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="SearchEntry"
                       Placeholder="Search term..."
                       HorizontalOptions="FillAndExpand" />
                <Button Text="Search"
                        Clicked="OnSearchClicked"
                        HorizontalOptions="End" />
            </Grid>

            <!-- Get All -->
            <Button Text="Get All List"
                    Clicked="OnFetchListClicked" />

        </VerticalStackLayout>

        <ProgressBar Grid.Row="1"
                     x:Name="LoadingBar"
                     IsVisible="False"
                     HeightRequest="3"
                     Margin="16,0,16,8" />

        <!-- Results -->
        <CollectionView Grid.Row="2" x:Name="ResultsList" Margin="16,0,16,16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CmsExampleModel">
                    <Frame Margin="0,6" Padding="12" HasShadow="True" BorderColor="Transparent" CornerRadius="12"
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <VerticalStackLayout Spacing="8">

                            <!-- Featured image -->
                            <Frame Padding="0" CornerRadius="10" IsClippedToBounds="True"
                                   HeightRequest="180" BorderColor="Transparent"
                                   BackgroundColor="{AppThemeBinding Light=#ECEFF1, Dark=#263238}">
                                <Image Source="{Binding FeaturedImageUrl}" Aspect="AspectFill" />
                            </Frame>

                            <!-- Title + Author -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontAttributes="Bold" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1"
                                       Text="{Binding Author, StringFormat='✍️ {0}'}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Body excerpt -->
                            <Label Text="{Binding Body}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                   MaxLines="3"
                                   LineBreakMode="TailTruncation" />

                            <!-- Stats row -->
                            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                                <Label Text="{Binding ViewsCount, StringFormat='👁️ {0:N0}'}"
                                       FontSize="12" TextColor="{AppThemeBinding Light=#607D8B, Dark=#B0BEC5}" />
                                <Label Text="{Binding EventDate, StringFormat='📅 {0}'}"
                                       FontSize="12" TextColor="{AppThemeBinding Light=#607D8B, Dark=#B0BEC5}" />
                                <Label Text="{Binding AuthorEmail, StringFormat='✍️ {0}'}"
                                       FontSize="11" TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"
                                       LineBreakMode="TailTruncation" />
                            </FlexLayout>

                            <!-- Category chips -->
                            <Label Text="{Binding Category, Converter={StaticResource ListToStringConverter}}"
                                   FontSize="11"
                                   TextColor="#1976D2"
                                   FontAttributes="Bold" />

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"
                                     Margin="0,2" />

                            <!-- Published status + date -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding IsPublished, StringFormat='Published: {0}'}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}" />
                                <Label Grid.Column="1"
                                       Text="{Binding PublishedAt, StringFormat='🗓 {0}'}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"
                                       HorizontalOptions="End" />
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
