<?xml version="1.0" encoding="UTF-8"?>

<Shell x:Class="AppAmbitTestingApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:AppAmbitTestingApp"
       FlyoutBehavior="Disabled"
       Title="AppAmbitTestingApp">

    <TabBar>
        <ShellContent Title="Crashes"
                      Icon="nav_crashes.svg"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage" />

         <ShellContent Title="Analytics"
                       Icon="nav_analytics.svg"
                       ContentTemplate="{DataTemplate local:AnalyticsPage}"
                       Route="AnalyticsPage" />

        <ShellContent Title="Config"
              Icon="nav_config.svg"
              ContentTemplate="{DataTemplate local:RemoteConfigPage}"
              Route="RemoteConfigPage" />

        <ShellContent Title="CMS"
              Icon="nav_cms.svg"
              ContentTemplate="{DataTemplate local:CmsPage}"
              Route="CmsPage" />

        <ShellContent Title="Data"
              Icon="nav_database.svg"
              ContentTemplate="{DataTemplate local:DatabasePage}"
              Route="DatabasePage" />

        <ShellContent Title="Cloud Code"
              Icon="nav_cloud.svg"
              ContentTemplate="{DataTemplate local:CloudCodePage}"
              Route="CloudCodePage" />
    </TabBar>
</Shell>
