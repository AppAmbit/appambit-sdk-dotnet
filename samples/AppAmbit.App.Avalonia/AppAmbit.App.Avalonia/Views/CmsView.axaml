<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:AppAmbitTestingAppAvalonia.Models"
             xmlns:views="using:AppAmbitTestingAppAvalonia.Views"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="700"
             x:Class="AppAmbitTestingAppAvalonia.Views.CmsView">

  <UserControl.Resources>
    <views:ListToStringConverter x:Key="ListToStringConverter" />
    <views:UrlToBitmapConverter x:Key="UrlToBitmapConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">

    <!-- Controls -->
    <StackPanel Grid.Row="0" Margin="16" Spacing="10">

      <TextBlock Text="CMS Query Builder"
                 FontSize="20"
                 FontWeight="Bold"
                 HorizontalAlignment="Center" />

      <!-- Filter Picker + Apply -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <ComboBox x:Name="FilterPicker"
                  Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Select a filter..." />
        <Button Grid.Column="1"
                Content="Apply"
                Click="OnApplyFilterClicked"
                MinWidth="80" />
      </Grid>

      <!-- Search -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="SearchEntry"
                 Grid.Column="0"
                 Watermark="Search term..."
                 VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="Search"
                Click="OnSearchClicked"
                MinWidth="80" />
      </Grid>

      <!-- Get All -->
      <Button Content="Get All List"
              HorizontalAlignment="Stretch"
              Click="OnFetchListClicked" />

    </StackPanel>

    <ProgressBar x:Name="LoadingBar"
                 Grid.Row="1"
                 IsIndeterminate="True"
                 IsVisible="False"
                 VerticalAlignment="Top"
                 Height="3"
                 Margin="16,0,16,4" />

    <!-- Results -->
    <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
      <ItemsControl x:Name="ResultsList" Margin="16,0,16,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:CmsExampleModel">
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,6,0,0">
              <StackPanel Spacing="8">

                <!-- Featured image -->
                <Border Height="180"
                        Background="#ECEFF1"
                        CornerRadius="10"
                        ClipToBounds="True">
                  <Image Source="{Binding FeaturedImageUrl, Converter={StaticResource UrlToBitmapConverter}}"
                         Stretch="UniformToFill" />
                </Border>

                <!-- Title -->
                <TextBlock Text="{Binding Title}"
                           FontWeight="Bold"
                           FontSize="16"
                           TextTrimming="CharacterEllipsis" />

                <!-- Body excerpt -->
                <TextBlock Text="{Binding Body}"
                           Foreground="#757575"
                           FontSize="13"
                           MaxLines="3"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />

                <!-- Stats row -->
                <WrapPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding ViewsCount, StringFormat='👁️ {0:N0}'}"
                             Foreground="#607D8B"
                             FontSize="12"
                             Margin="0,0,16,0" />
                  <TextBlock Text="{Binding EventDate, StringFormat='📅 {0}'}"
                             Foreground="#607D8B"
                             FontSize="12"
                             Margin="0,0,16,0" />
                  <TextBlock Text="{Binding AuthorEmail, StringFormat='✍️ {0}'}"
                             Foreground="#9E9E9E"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                </WrapPanel>

                <!-- Category -->
                <TextBlock Text="{Binding Category, Converter={StaticResource ListToStringConverter}}"
                           Foreground="#1976D2"
                           FontWeight="Bold"
                           FontSize="11" />

                <Border Height="1" Background="#EEEEEE" Margin="0,2" />

                <!-- Published status + date -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="{Binding IsPublished, StringFormat='Published: {0}'}"
                             Foreground="#9E9E9E"
                             FontSize="11" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding PublishedAt, StringFormat='🗓 {0}'}"
                             Foreground="#9E9E9E"
                             FontSize="11"
                             HorizontalAlignment="Right" />
                </Grid>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>
</UserControl>
