<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:AppAmbitTestingAppAvalonia.Models"
             xmlns:views="using:AppAmbitTestingAppAvalonia.Views"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="700"
             x:Class="AppAmbitTestingAppAvalonia.Views.CmsView">

  <UserControl.Resources>
    <views:IsPublishedColorConverter x:Key="IsPublishedColorConverter" />
    <views:IsPublishedLabelConverter x:Key="IsPublishedLabelConverter" />
    <views:ListToStringConverter x:Key="ListToStringConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- Header -->
    <TextBlock Grid.Row="0"
               Text="CMS Query Builder"
               FontSize="20"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="12,16,12,8" />

    <!-- Filter row -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,0,12,8">
      <ComboBox x:Name="FilterPicker"
                Grid.Column="0"
                Margin="0,0,8,0"
                HorizontalAlignment="Stretch"
                PlaceholderText="Select a filter..." />
      <Button x:Name="BtnApplyFilter"
              Grid.Column="1"
              Content="Apply"
              Click="OnApplyFilterClicked"
              MinWidth="90" />
    </Grid>

    <!-- Search row -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,0,12,8">
      <TextBox x:Name="SearchBox"
               Grid.Column="0"
               Watermark="Search term..."
               Margin="0,0,8,0"
               VerticalAlignment="Center" />
      <Button x:Name="BtnSearch"
              Grid.Column="1"
              Content="Search"
              Click="OnSearchClicked"
              MinWidth="90" />
    </Grid>

    <!-- Results area -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*">

      <Button Grid.Row="0"
              x:Name="BtnFetchAll"
              Content="Get All List"
              HorizontalAlignment="Stretch"
              Margin="12,0,12,8"
              Click="OnFetchAllClicked" />

      <ProgressBar Grid.Row="1"
                   x:Name="LoadingBar"
                   IsIndeterminate="True"
                   IsVisible="False"
                   Margin="12,0,12,4"
                   Height="3" />

      <ScrollViewer Grid.Row="2">
        <StackPanel Margin="12,0,12,12" Spacing="8">

          <TextBlock x:Name="EmptyLabel"
                     Text="No posts found."
                     IsVisible="False"
                     TextWrapping="Wrap"
                     Foreground="#6B7280"
                     FontSize="14"
                     Margin="0,8,0,0" />

          <ItemsControl x:Name="ResultsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:CmsExampleModel">
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,3,0,3">
                  <StackPanel Spacing="8">

                    <!-- Featured image -->
                    <Border Height="180"
                            Background="#ECEFF1"
                            CornerRadius="8"
                            ClipToBounds="True">
                      <Image Source="{Binding FeaturedImageBitmap}"
                             Stretch="UniformToFill" />
                    </Border>

                    <!-- Title + Author -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Title}"
                                 FontWeight="Bold"
                                 FontSize="16"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Author, StringFormat='✍️ {0}'}"
                                 Foreground="#757575"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <!-- Body excerpt -->
                    <TextBlock Text="{Binding Body}"
                               Foreground="#757575"
                               FontSize="13"
                               MaxLines="3"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Stats row -->
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding ViewsCount, StringFormat='👁️ {0:N0}'}"
                                 Foreground="#607D8B"
                                 FontSize="12"
                                 Margin="0,0,16,0" />
                      <TextBlock Text="{Binding EventDate, StringFormat='📅 {0}'}"
                                 Foreground="#607D8B"
                                 FontSize="12"
                                 Margin="0,0,16,0" />
                      <TextBlock Text="{Binding AuthorEmail, StringFormat='✍️ {0}'}"
                                 Foreground="#9E9E9E"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </WrapPanel>

                    <!-- Categories -->
                    <TextBlock Text="{Binding Category, Converter={StaticResource ListToStringConverter}}"
                               Foreground="#1976D2"
                               FontWeight="Bold"
                               FontSize="11" />

                    <!-- Separator -->
                    <Border Height="1" Background="#EEEEEE" Margin="0,2" />

                    <!-- Published status + date -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Grid.Column="0"
                              CornerRadius="4"
                              Padding="6,2"
                              Background="{Binding IsPublished, Converter={StaticResource IsPublishedColorConverter}}">
                        <TextBlock Text="{Binding IsPublished, Converter={StaticResource IsPublishedLabelConverter}}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PublishedAt, StringFormat='📅 {0}'}"
                                 Foreground="#9E9E9E"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Right" />
                    </Grid>

                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
